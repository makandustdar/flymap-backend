# Copy to .env before: docker compose up -d --build
#   cp .env.example .env

# --- Django ---
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your.domain.com
CSRF_TRUSTED_ORIGINS=https://your.domain.com

# Host port published for Django/Gunicorn (host nginx → 127.0.0.1:8786)
HOST_PORT=8786

# --- Postgres (compose service `db`) ---
POSTGRES_DB=flymap
POSTGRES_USER=flymap
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgres://flymap:change-me-strong-password@db:5432/flymap

# --- Optional ---
WINDY_POINT_FORECAST_KEY=
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Behind host nginx TLS termination — keep False unless you terminate TLS in-app
SECURE_SSL_REDIRECT=False
