# Local development
DJANGO_SECRET_KEY=change-me-local
DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Windy Point Forecast API key (Professional). Leave empty to use node.windy.com MVP.
WINDY_POINT_FORECAST_KEY=

# Optional local Postgres
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/flymap

# ---------------------------------------------------------------------------
# ParsPack PaaS Env Vars (panel)
# Docs: https://docs.parspack.com/paas/deploy/programming-languages/django/
#
# Panel fields / recommended values:
#   django_secret_key     → auto or custom (also maps to DJANGO_SECRET_KEY)
#   DEBUG                 → False
#   DJANGO_ALLOWED_HOSTS  → your-app.parspack.app,your.domain.com
#   CSRF_TRUSTED_ORIGINS  → https://your-app.parspack.app,https://your.domain.com
#   DATABASE_URL          → from ParsPack Postgres addon (preferred over SQLite)
#   WINDY_POINT_FORECAST_KEY → optional
#   PORT                  → 8000 (default; must match panel)
#   WEB_CONCURRENCY       → 2 (optional)
#
# Deploy panel parameters:
#   django_context_dir    → .   (if Git root = this backend folder)
#                         → backend  (if Git root = flymap/ parent)
#   app config            → gunicorn.conf.py
#   port                  → 8000
# ---------------------------------------------------------------------------
